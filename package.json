{
  "name": "genesis-grove",
  "version": "0.19.0",
  "description": "An original living-world god sandbox for macOS and Windows",
  "author": "Genesis Grove",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "src/desktop.cjs",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "lint": "node scripts/check.mjs",
    "build": "electron-builder --dir",
    "dist:mac": "electron-builder --mac zip --publish never",
    "dist:win": "electron-builder --win nsis portable --publish never",
    "smoke": "electron scripts/smoke.cjs",
    "icon": "electron scripts/icon.cjs",
    "dist:win:zip": "electron-builder --win zip --x64 --config.win.signAndEditExecutable=false --publish never"
  },
  "devDependencies": {
    "electron": "43.7.7",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "io.genesisgrove.sandbox",
    "productName": "Genesis Grove",
    "asar": true,
    "files": [
      "src/**/*",
      "assets/**/*",
      "index.html",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.simulation-games",
      "target": [
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "icon": "assets/icon.png"
  }
}
